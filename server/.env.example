# Copy to server/.env (git-ignored) and fill in. Never commit real values.

PORT=8080
HOST=127.0.0.1

# demo = sample diary data (no CRM needed); leave empty/live for real diaries
DIARY_MODE=demo

# Where bookings, holds and the postcode cache are written (private, server-side)
# DATA_DIR=./server/data

# Optional: POST each lead and booking request to a CRM / Zapier / Power Automate webhook
# LEAD_WEBHOOK_URL=

# Email each lead to the right office. Leads are always written to the private log first.
# Needs DIARY_MODE removed (demo mode never emails). Recipients are set here only, never taken from the form.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for implicit TLS (port 465)
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="My Property Box website <website@yourdomain.co.uk>"
# LEAD_EMAIL_TO=             # default inbox (comma separated)
# LEAD_EMAIL_DARLINGTON=     # optional per-office inboxes; fall back to LEAD_EMAIL_TO
# LEAD_EMAIL_NEWCASTLE=
# LEAD_EMAIL_NORTHALLERTON=
# LEAD_EMAIL_CARLISLE=
# LEAD_EMAIL_PENRITH=
# LEAD_EMAIL_KENDAL=
# LEAD_EMAIL_CC=             # copied on every lead
# RATE_LEADS=10              # leads per IP per 10 minutes
# RATE_LEADS_GLOBAL=200      # emails per hour overall; beyond this leads are logged but not emailed

# Viewing rules
# VIEWING_DAYS=10
# VIEWING_LEAD_HOURS=3
# CLOSED_DATES=2026-12-25,2026-12-26
# RATE_BOOKINGS=6

# Behind a reverse proxy (nginx, Cloudflare, ...)
# TRUST_PROXY=1
# ALLOWED_ORIGIN=https://www.example.co.uk

# Geocoding: only postcodes are ever sent to postcodes.io
# GEOCODE=off
# GEOCODE_PRECISION=outcode

# Veco Plus diary (read-only). Needs an API client issued by Veco (client credentials, scope scheduler-service).
# Once the client id and secret are in, run: node server/veco-check.js
# It lists the staff ids to put in VECO_RESOURCE_IDS (the people whose diaries count towards availability).
# VECO_CLIENT_ID=
# VECO_CLIENT_SECRET=
# VECO_RESOURCE_IDS=
# Defaults: API https://api.all.veco.plus, identity https://identity.all.veco.plus, scope scheduler-service
# VECO_API_BASE=
# VECO_IDENTITY_URL=
# VECO_SCOPE=
